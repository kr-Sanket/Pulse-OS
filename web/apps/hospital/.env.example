# Hospital portal environment — copy to .env.local (gitignored) and fill in.
# The same Firebase project as the other portals: the backend verifies every portal's
# tokens against one project (audience check), so these must match.
VITE_FIREBASE_API_KEY=CHANGEME
VITE_FIREBASE_AUTH_DOMAIN=CHANGEME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=CHANGEME

# Backend API origin (defaults to the local dev server).
VITE_API_BASE_URL=http://localhost:8000
