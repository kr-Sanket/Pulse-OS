# Patient portal environment — copy to .env.local (gitignored) and fill in.
# Values come from Firebase console → Project settings → Your apps → Web app.
# These are client-side identifiers, not secrets — but never commit real ones anyway.
VITE_FIREBASE_API_KEY=CHANGEME
VITE_FIREBASE_AUTH_DOMAIN=CHANGEME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=CHANGEME

# Backend API origin (defaults to the local dev server).
VITE_API_BASE_URL=http://localhost:8000

# Leaving the VITE_FIREBASE_* values unset in a **dev build only** (pnpm dev) makes the
# portal sign in as a mock user so UI work needs no Firebase project. Filling them in
# disables the mock. Production builds always require them.
