{
  "name": "@pulseos/api-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Type-safe API client — GENERATED from the backend OpenAPI spec (ADR-003). Do not hand-edit generated output.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@pulseos/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
