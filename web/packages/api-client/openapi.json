        "title": "RecordOrigin",
        "type": "string"
      },
      "RecordProcessingStatus": {
        "description": "ADR-008 pipeline states. M2 only ever writes UPLOADED \u2014 the OCR/embedding worker\nthat advances records to PROCESSING/INDEXED/FAILED is the M5 AI milestone.",
        "enum": [
          "UPLOADED",
          "PROCESSING",
          "INDEXED",
          "FAILED"
        ],
        "title": "RecordProcessingStatus",
        "type": "string"
      },
      "Role": {
        "description": "The four platform roles (docs/DOMAIN_MODEL.md \u00a73, ADR-013).\n\nSYSTEM_ADMIN is a platform-operations role with a hard invariant: it can never\nread medical content, so it must never appear in a role gate on a PHI endpoint.",
        "enum": [
          "PATIENT",
          "DOCTOR",
          "HOSPITAL_ADMIN",
          "SYSTEM_ADMIN"
        ],
        "title": "Role",
        "type": "string"
