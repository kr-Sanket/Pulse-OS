  "info": {
    "title": "PulseOS",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/me": {
      "get": {
        "description": "Return the caller's authenticated identity.\n\nRoles: any authenticated, provisioned user. Failure modes: 401 (missing/malformed/\ninvalid/expired token), 403 (unprovisioned account), 503 (provider unavailable).",
        "operationId": "read_current_user_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Current User",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/doctors/me": {
      "get": {
        "description": "The caller's own doctor profile with hospital context.\n\nRoles: DOCTOR. Failure modes: 401, 403, 404 (no doctor profile row).",
        "operationId": "read_own_doctor_profile_api_v1_doctors_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Own Doctor Profile",
        "tags": [
          "doctors"
        ]
      }
    },
    "/api/v1/doctors/register": {
      "post": {
        "description": "Register the caller as a doctor of a VERIFIED hospital (ADR-015 step 3).\n\nRoles: any *verified* identity \u2014 PulseOS claims are not required yet. Idempotent\n(repeat calls \u2192 200). The profile starts PENDING until the hospital admin activates\nit. Failure modes: 401, 409 (different role / hospital not verified), 422 (validation\nor unknown hospital HID), 503 (auth provider down \u2014 nothing is persisted).",
        "operationId": "register_doctor_api_v1_doctors_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DoctorRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorProfileResponse"
                }
              }
            },
            "description": "Already registered"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Doctor",
        "tags": [
          "doctors"
        ]
      }
    },
    "/api/v1/hospitals/me": {
      "get": {
        "description": "The caller's own hospital (ADR-013 layers 1+2 by construction).\n\nRoles: HOSPITAL_ADMIN. Failure modes: 401, 403, 404 (no admin profile row).",
        "operationId": "read_own_hospital_api_v1_hospitals_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitalAdminProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Own Hospital",
        "tags": [
          "hospitals"
        ]
      }
    },
    "/api/v1/hospitals/me/doctors": {
      "get": {
        "description": "The caller's hospital's doctors, newest first, cursor-paginated.\n\nRoles: HOSPITAL_ADMIN (own hospital only \u2014 other hospitals' rosters are invisible).\nFailure modes: 401, 403, 404 (no admin profile), 422 (bad cursor/limit).",
        "operationId": "list_own_hospital_doctors_api_v1_hospitals_me_doctors_get",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Own Hospital Doctors",
        "tags": [
          "hospitals"
        ]
      }
    },
    "/api/v1/hospitals/me/doctors/{doctor_id}/activate": {
      "post": {
        "description": "Activate a doctor of the caller's hospital (ADR-015 step 3). Idempotent.\n\nRoles: HOSPITAL_ADMIN. Failure modes: 401, 403, 404 (unknown doctor OR a doctor of\nanother hospital \u2014 indistinguishable by design).",
        "operationId": "activate_doctor_api_v1_hospitals_me_doctors__doctor_id__activate_post",
        "parameters": [
          {
            "in": "path",
            "name": "doctor_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Doctor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activate Doctor",
        "tags": [
          "hospitals"
        ]
      }
    },
    "/api/v1/hospitals/me/doctors/{doctor_id}/deactivate": {
      "post": {
        "description": "Deactivate (remove) a doctor of the caller's hospital. Idempotent.\n\nThe row is kept (DISABLED) \u2014 identities referenced by records/audit are never deleted\n(docs/DATABASE_DESIGN.md principle 5). Roles/failures: as for activate.",
        "operationId": "deactivate_doctor_api_v1_hospitals_me_doctors__doctor_id__deactivate_post",
        "parameters": [
          {
            "in": "path",
            "name": "doctor_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Doctor Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deactivate Doctor",
        "tags": [
          "hospitals"
        ]
      }
    },
    "/api/v1/hospitals/register": {
      "post": {
        "description": "Register a new hospital with the caller as its admin (ADR-015 step 1).\n\nRoles: any *verified* identity \u2014 PulseOS claims are not required yet. Idempotent:\nrepeat calls return the existing hospital with 200. The hospital starts PENDING;\na System Admin must verify it before it can register doctors or upload records.\nFailure modes: 401, 409 (registered with a different role), 422, 503 (auth provider\ndown \u2014 nothing is persisted).",
        "operationId": "register_hospital_api_v1_hospitals_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HospitalRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HospitalAdminProfileResponse"
                }
