{
  "components": {
    "schemas": {
      "AuthenticatedUserResponse": {
        "properties": {
          "firebaseUid": {
            "title": "Firebaseuid",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "userId": {
            "format": "uuid",
            "title": "Userid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "firebaseUid",
          "role"
        ],
        "title": "AuthenticatedUserResponse",
        "type": "object"
      },
      "Gender": {
        "description": "FHIR administrative-gender vocabulary, SCREAMING_SNAKE per API_GUIDELINES.",
        "enum": [
          "MALE",
          "FEMALE",
          "OTHER",
          "UNKNOWN"
        ],
        "title": "Gender",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PatientProfileResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "dateOfBirth": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dateofbirth"
          },
          "fullName": {
            "title": "Fullname",
            "type": "string"
          },
          "gender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gender"
              },
              {
                "type": "null"
              }
            ]
          },
          "healthId": {
            "title": "Healthid",
            "type": "string"
          }
        },
        "required": [
          "healthId",
          "fullName",
          "dateOfBirth",
          "gender",
          "createdAt"
        ],
        "title": "PatientProfileResponse",
        "type": "object"
      },
      "PatientRegistrationRequest": {
        "additionalProperties": false,
        "properties": {
          "dateOfBirth": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dateofbirth"
          },
          "fullName": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Fullname",
            "type": "string"
          },
          "gender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gender"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fullName"
        ],
        "title": "PatientRegistrationRequest",
        "type": "object"
      },
      "Role": {
        "description": "The four platform roles (docs/DOMAIN_MODEL.md \u00a73, ADR-013).\n\nSYSTEM_ADMIN is a platform-operations role with a hard invariant: it can never\nread medical content, so it must never appear in a role gate on a PHI endpoint.",
        "enum": [
          "PATIENT",
          "DOCTOR",
          "HOSPITAL_ADMIN",
          "SYSTEM_ADMIN"
        ],
        "title": "Role",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "PulseOS",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/me": {
      "get": {
        "description": "Return the caller's authenticated identity.\n\nRoles: any authenticated, provisioned user. Failure modes: 401 (missing/malformed/\ninvalid/expired token), 403 (unprovisioned account), 503 (provider unavailable).",
        "operationId": "read_current_user_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedUserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Current User",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/patients/me": {
      "get": {
        "description": "Return the caller's own patient profile.\n\nRoles: PATIENT (ADR-013 layer 1 + own-profile relationship by construction).\nFailure modes: 401, 403 (wrong role / unprovisioned), 404 (no profile row).",
        "operationId": "read_own_profile_api_v1_patients_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Own Profile",
        "tags": [
          "patients"
        ]
      }
    },
    "/api/v1/patients/register": {
      "post": {
        "description": "Register the authenticated Firebase subject as a patient and issue a Health ID.\n\nRoles: any *verified* identity \u2014 PulseOS claims are not required yet (this endpoint\ncreates them). Idempotent: repeat calls return the existing profile with 200.\nFailure modes: 401 (bad token), 409 (registered with a different role),\n422 (validation), 503 (auth provider down \u2014 nothing is persisted).",
        "operationId": "register_patient_api_v1_patients_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientProfileResponse"
                }
              }
            },
            "description": "Already registered"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientProfileResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register Patient",
        "tags": [
          "patients"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness probe: the process is up. No dependency checks (that is /ready).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "infra"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness probe: 200 when every dependency answers, 503 otherwise.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "infra"
        ]
      }
    }
  }
}
