# PulseOS environment configuration.
# Copy to .env (`make env`) and adjust. Everything here has a safe LOCAL default;
# values marked CHANGEME are required only from the milestone noted.
# NEVER commit .env. NEVER reuse these defaults outside local development.

# --- Application (read by backend, prefix PULSEOS_) ---
PULSEOS_ENVIRONMENT=local
PULSEOS_DEBUG=true
PULSEOS_LOG_LEVEL=INFO
# Browser origins allowed by CORS (JSON list). Default covers the three portal dev servers.
# PULSEOS_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# --- PostgreSQL (read by docker-compose AND backend) ---
POSTGRES_USER=pulseos
POSTGRES_PASSWORD=pulseos
POSTGRES_DB=pulseos
POSTGRES_PORT=5432
PULSEOS_DATABASE_URL=postgresql+asyncpg://pulseos:pulseos@localhost:5432/pulseos

# --- Redis ---
REDIS_PORT=6379
PULSEOS_REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 (ADR-005) ---
MINIO_ROOT_USER=pulseos
MINIO_ROOT_PASSWORD=pulseos-local-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PULSEOS_S3_ENDPOINT_URL=http://localhost:9000
PULSEOS_S3_ACCESS_KEY=pulseos
PULSEOS_S3_SECRET_KEY=pulseos-local-secret
PULSEOS_S3_BUCKET_RECORDS=pulseos-records
# MinIO ignores the region but the S3 SDK requires one (real S3 uses it for signing).
PULSEOS_S3_REGION=us-east-1
# Presigned download URLs stay valid this long (docs/SECURITY.md: short-lived, minutes).
PULSEOS_S3_PRESIGN_TTL_SECONDS=300

# --- Records (M2) ---
# Hard upload size cap in bytes (default 15 MiB).
PULSEOS_RECORDS_MAX_UPLOAD_BYTES=15728640

# --- Rate limiting (ADR-024, M3-D) ---
# Off installs a permissive limiter (tests and credential-free dev use this).
PULSEOS_RATE_LIMIT_ENABLED=true
# Optional per-bucket overrides as JSON: "limit/window-seconds". Only the named buckets
# change; the rest keep the defaults in app/core/ratelimit.py. Buckets:
#   patient_lookup 20/60 · record_existence 30/60 · granted_records 30/60
#   access_request_create 10/60
# PULSEOS_RATE_LIMITS={"patient_lookup":"40/60"}

# --- Firebase Auth (ADR-011, M0.3) ---
# Path to a Firebase service-account JSON. Leave unset to use Application Default
# Credentials. Without either, auth endpoints answer 503; the rest of the API works.
# PULSEOS_FIREBASE_CREDENTIALS_FILE=CHANGEME

# --- AI Answer Generation (Ollama local, ADR-007) ---
# PULSEOS_AI_PROVIDER=ollama
# PULSEOS_OLLAMA_BASE_URL=http://localhost:11434
# PULSEOS_OLLAMA_MODEL=qwen3:8b
# PULSEOS_OLLAMA_TIMEOUT_SECONDS=60.0

# --- Merkle-batched audit anchoring (ADR-027, M6.3) ---
# Maximum leaves per sealed batch; sealing interval (used once a scheduler exists, a later
# stage); age after which an unbatched v3 event is reported as backlog by reconciliation.
# PULSEOS_AUDIT_BATCH_MAX_SIZE=256
# PULSEOS_AUDIT_BATCH_INTERVAL_SECONDS=300
# PULSEOS_AUDIT_BATCH_BACKLOG_THRESHOLD_SECONDS=900

# --- Later milestones (uncomment when the milestone starts) ---
# PULSEOS_CHAIN_RPC_URL=CHANGEME               # M6 (blockchain, ADR-004)
# PULSEOS_ANCHOR_WALLET_PRIVATE_KEY=CHANGEME   # M6 — testnet-only wallet
# PULSEOS_SENTRY_DSN=CHANGEME                  # M7 (observability)
